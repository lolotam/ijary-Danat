# =====================================================================
# IJARY Multi-Company SaaS — environment variables
# Copy to .env (dev) and set as Dokploy secrets (prod).
# =====================================================================

# --- Client-visible (Vite) ---------------------------------------------
# Public URL of your self-hosted Supabase project (Kong / REST endpoint).
VITE_SUPABASE_URL=https://supabase.example.com
# Publishable (anon) key from your self-hosted Supabase project.
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
# Sentry browser DSN (public, write-only). Leave empty to disable Sentry.
VITE_SENTRY_DSN=
# PostHog browser analytics (public project token + ingest host, e.g.
# https://us.i.posthog.com). Leave either empty to disable PostHog.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=

# --- Build-time secrets (never baked into the bundle, never at runtime) ---
# Lets the Sentry Vite plugin upload source maps during `vite build`. Optional;
# a credential, so keep it out of the client group above and the runtime env.
# Docker/Dokploy builds take it as a build secret, not from this file (see Dockerfile).
SENTRY_AUTH_TOKEN=

# --- Server-only (never expose in VITE_ vars) --------------------------
# Required at startup (`validateEnv()` in src/lib/env.server.ts): Lovable preview
# must also have these 5 new secrets set (`SELF_SUPABASE_JWT_SECRET` where the
# `SUPABASE_*` prefix is reserved, plus `INTEGRATIONS_MASTER_KEY`, `REDIS_URL`,
# `PLATFORM_ROOT_HOST`, and `PLATFORM_ADMIN_HOST`) or every request fails with 500.
SUPABASE_URL=https://supabase.example.com
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
# service_role key — TRUSTED. Never ship to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# JWT secret of your self-hosted Supabase stack (GoTrue/PostgREST JWT_SECRET).
# Used to sign short-lived company_service and support-session tokens (alias: SELF_SUPABASE_JWT_SECRET).
SUPABASE_JWT_SECRET=
# 32 random bytes, base64-encoded — AES-256-GCM master key for company_secrets.
# Generate with: openssl rand -base64 32
INTEGRATIONS_MASTER_KEY=
# Sentry server DSN (runtime). Falls back to VITE_SENTRY_DSN when empty.
SENTRY_DSN=

# --- Platform hosts (multi-company routing, server-only) ---------------
# Hostnames only (no http:// or path). Subdomains resolve as <slug>.<PLATFORM_ROOT_HOST>.
# Dev: localhost / admin.localhost  |  Prod: ijary.app / admin.ijary.app
PLATFORM_ROOT_HOST=localhost
PLATFORM_ADMIN_HOST=admin.localhost
# Read X-Forwarded-Host only when a proxy in front overwrites it. Traefik passes
# Host through unchanged, so leave this false; any client can forge the header.
TRUST_FORWARDED_HOST=false

# --- Background worker (Redis / BullMQ, server-only) -------------------
# Dev: redis://localhost:6379  |  Docker compose: redis://redis:6379
REDIS_URL=redis://localhost:6379

# --- MyFatoorah gateway (server-only) ---------------------------------
# Sandbox (current testing): BASE_URL=https://apitest.myfatoorah.com
# Live Kuwait: BASE_URL=https://api.myfatoorah.com
# Status inquiry uses GET /v3/payments/{paymentId} then falls back to POST /v2/GetPaymentStatus
# (POST /v3/GetPaymentStatus 404s on the test API).
# Webhook URL to register in MyFatoorah portal:
#   https://danat-future.com/api/public/myfatoorah-webhook
# MYFATOORAH_WEBHOOK_SECRET is the HMAC secret from the MyFatoorah Webhook settings
# page (not the API token). Leave empty only while relying on callback settlement.
#
# The API key, the webhook secret and the portal's webhook registration are all
# PER-ENVIRONMENT. Moving to live means changing all three together: a live key
# beside a sandbox secret leaves signature checks failing, and settlement quietly
# falls back to the payment-reconcile cron while everything still looks healthy.
#
# The tenant portal pins each payment to one of KNET / GOOGLE_PAY / APPLE_PAY, so
# all three must be enabled on whichever account this key belongs to.
MYFATOORAH_API_KEY=
MYFATOORAH_BASE_URL=https://apitest.myfatoorah.com
MYFATOORAH_WEBHOOK_SECRET=

# --- Gmail inbox sync (server-only) -----------------------------------
# Connect a mailbox from /admin/settings/integrations; the OAuth callback
# stores the refresh token in gmail_connections. Create the OAuth client in
# Google Cloud Console (type: Web application) and register the redirect URI
# below as an Authorized redirect URI.
# The `state` parameter is signed with CRON_SECRET, so that must also be set.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://danat-future.com/api/oauth/google/callback
# Optional: which mailbox to read; "me" (default) is the account that consented.
GMAIL_SYNC_ADDRESS=
# Optional: how far back a tick looks, in Gmail search syntax. Default 30d.
GMAIL_SYNC_WINDOW=30d
# Fallback only, and best left empty. A hand-minted refresh token used when no
# mailbox has been connected in-app.
#
# LEAVE THIS UNSET on any deployment that uses the Connect Gmail button. It is
# consulted only when `gmail_connections` is empty, but a token minted by hand
# carries whatever scopes it was created with — typically read-only, since that
# was the only scope before 2026-08-01. If one is set and the in-app connection
# is later removed, the app silently falls back to it, keeps syncing happily,
# and refuses every send with a scope error that looks like a bug in the send
# path rather than a stale credential.
GMAIL_REFRESH_TOKEN=

# --- Platform default email sender (used when a company has no sender) -
# Provider ("resend" or "smtp") and verified sender address (e.g. no-reply@ijary.app).
# Credentials use RESEND_API_KEY or SMTP_* below.
PLATFORM_EMAIL_PROVIDER=
PLATFORM_EMAIL_FROM=
# Svix signing secret for POST /api/public/webhooks/resend-platform (`whsec_...`).
PLATFORM_RESEND_WEBHOOK_SECRET=

# --- Email providers (mutually exclusive — see docs/NOTIFICATION_PROVIDER_SETUP.md)
# SMTP is the fallback; Resend is the preferred production provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# RESEND_FROM must be an address on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
# RESEND_WEBHOOK_SECRET is the `whsec_...` signing secret Resend shows when you
# add the Resend webhook endpoint. Only delivery reporting depends on it — sending
# works without it — but while it is unset the endpoint answers 503 and bounces
# are dropped unrecorded.
RESEND_WEBHOOK_SECRET=

# --- Platform Meta App (WhatsApp Cloud API & Embedded Signup) ----------
# Used for POST /api/public/webhooks/meta signature verification, Embedded Signup
# code exchange, and coexistence onboarding.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0

# --- WhatsApp Cloud API (legacy single-company env vars) ---------------
# WHATSAPP_ACCESS_TOKEN must be a System User token in production, not the
# temporary 24-hour token shown in the Meta quickstart.
# Required permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
# NOTE: WHATSAPP_TEMPLATE_NAMESPACE was required by the deprecated On-Premises
# API only. The Cloud API /messages endpoint identifies templates by name and
# language, so the namespace is not read anywhere and has been removed.
# Approved Meta template names live in notification_templates.provider_template_name.

# --- Twilio WhatsApp (mutually exclusive with WhatsApp Cloud API) ------
# Approved Content SIDs live in notification_templates.twilio_content_sid.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Evolution API WhatsApp (shared platform QR server) ----------------
# Base URL and global API key (AUTHENTICATION_API_KEY) of the platform-hosted
# Evolution container. Each company gets its own instance derived from company_id.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Public app URL used in credential emails / portal links / payment callback
PUBLIC_APP_URL=https://danat-future.com
APP_BASE_URL=https://danat-future.com

# --- Scheduled jobs (server-only) --------------------------------------
# Shared secret for POST /api/public/cron. Required, or the endpoint returns 503.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- App runtime -------------------------------------------------------
NODE_ENV=production
PORT=3000
