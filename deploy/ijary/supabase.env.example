# IJARY — self-hosted Supabase stack environment template.
#
# Every value here is a placeholder; real keys never live in this file. The web
# application and the whole Supabase stack (Postgres, GoTrue, PostgREST, Storage,
# Realtime, Kong) are deployed separately as Dokploy applications on the same
# host as deploy/ijary/docker-compose.yml, which runs only Redis and the worker.
# Copy this file to an untracked .env next to the deployment it configures and
# fill in real values there; .gitignore already ignores .env.*.
#
# Two naming families appear below because two setups read them: the GOTRUE_*
# names are what the GoTrue container reads directly (as in
# dev-local/docker-compose.yml), while SITE_URL / ADDITIONAL_REDIRECT_URLS are
# the supabase/docker .env names that its compose maps onto the GOTRUE_* ones.
# Set the family the deployed compose actually reads.

# --- GoTrue: where a sign-in may return to --------------------------------

# The one canonical site URL GoTrue puts in emails and falls back to as the
# post-sign-in redirect. It is the platform root host (CLAUDE.md hosts table).
GOTRUE_SITE_URL=https://ijary.app
SITE_URL=https://ijary.app

# The redirect allow-list: every URL GoTrue may send a browser to after an
# auth flow (magic link, OAuth callback, password recovery). Comma-separated
# URI patterns; the path part is a glob (`/**`), a single star never crosses a
# slash. https://*.ijary.app/** covers every host with a subdomain label
# (admin.ijary.app and each company's <slug>.ijary.app); the bare root host
# needs its own entry because the wildcard cannot match it. Verified custom
# domains (a later user story) are appended per company as each one is added —
# never by widening the wildcard.
GOTRUE_URI_ALLOW_LIST=https://ijary.app/**,https://admin.ijary.app/**,https://*.ijary.app/**
ADDITIONAL_REDIRECT_URLS=https://ijary.app/**,https://admin.ijary.app/**,https://*.ijary.app/**

# --- API (Kong): which browser origins may call the API -------------------

# Comma-separated origins (scheme + host, no paths — CORS matches origins, not
# URL patterns) for the `cors` plugin's `config.origins` in the Kong
# declarative config (the dev-local/volumes/api/kong.yml pattern). Kong's CORS
# policy lives in that declarative config, not in a Kong environment setting;
# the compose entrypoint renders kong.yml against the container environment,
# so this name is read at render time. Same three hosts as the redirect
# allow-list; custom domains join this list per company too.
API_CORS_ORIGINS=https://ijary.app,https://admin.ijary.app,https://*.ijary.app

# --- Server-only secrets (placeholders — fill in the untracked .env) ------

# The service_role JWT the server and worker sign admin calls with; bypasses
# RLS, so it exists only in server and worker environments.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-jwt
# The secret every JWT the stack issues is signed and verified with.
SUPABASE_JWT_SECRET=replace-with-jwt-secret
# AES-256-GCM key (32 random bytes, base64) that encrypts company_secrets
# (research.md R9); held only by the server and the worker.
INTEGRATIONS_MASTER_KEY=replace-with-32-byte-base64-key

# These three secrets must never be renamed with a VITE_ prefix: Vite compiles
# VITE_-prefixed variables into the browser bundle (CLAUDE.md security rules).
